# Organizer API: the "GET for DEV" link WITHOUT the trailing &group_id=... part.
# It carries a signature (sig=...): keep it only in .env, never commit it.
CQA_API_URL=

# LLM provider key (choose the provider in decisions.md). Server side only.
ANTHROPIC_API_KEY=

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Engines used by the API, first = primary, the rest = fallback (each fallback is recorded on the evaluation).
# Format: <evaluator>[:<model>], comma-separated. Default below if empty.
CQA_ENGINES=gemini:gemma-4-31b-it,gemini:gemini-3.5-flash,gemini:gemini-3.8-flash,gemini:gemini-3-flash-preview,gemini:gemini-2.5-flash
# Dialogs evaluated in parallel inside one job (Gemma ~100 s per dialog; keep under the per-minute limit)
CQA_JOB_CONCURRENCY=3
# Price per 1M tokens (USD) for the cost shown per evaluation; leave empty/0 on a free tier.
CQA_PRICE_IN_PER_MTOK=
CQA_PRICE_OUT_PER_MTOK=
# Browser origins allowed to call the API (e.g. a Dynamics 365 host). Default: localhost:8000.
CQA_CORS_ORIGINS=
# Hosts the call-audio proxy may contact (leading dot = subdomains). Default: organizer API host + .dynamics.com
CQA_AUDIO_HOSTS=

# OpenAI-compatible providers (evaluator name = provider, always pass --model). Fill only what you use.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# local FreeLLMAPI router (unified key from its dashboard); Ollama needs no key
FREELLMAPI_API_KEY=
# optional URL overrides, e.g. OLLAMA_BASE_URL=http://192.168.1.10:11434/v1
# OLLAMA_BASE_URL=
# FREELLMAPI_BASE_URL=

# Team name written into results/<set>/results.json (python -m cqa export)
CQA_TEAM_NAME=
