# Organizer API: the "GET for DEV" link WITHOUT the trailing &group_id=... part.
# It carries a signature (sig=...): keep it only in .env, never commit it.
CQA_API_URL=

# LLM provider key (choose the provider in decisions.md). Server side only.
ANTHROPIC_API_KEY=

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI-compatible providers (evaluator name = provider, always pass --model). Fill only what you use.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# local FreeLLMAPI router (unified key from its dashboard); Ollama needs no key
FREELLMAPI_API_KEY=
# optional URL overrides, e.g. OLLAMA_BASE_URL=http://192.168.1.10:11434/v1
# OLLAMA_BASE_URL=
# FREELLMAPI_BASE_URL=
